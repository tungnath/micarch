# ─── Maven build output ───────────────────────────────────────────────────────
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Maven wrapper
.mvn/wrapper/maven-wrapper.properties

# ─── IDE — IntelliJ IDEA ──────────────────────────────────────────────────────
.idea/
*.iws
*.iml
*.ipr
out/

# IDE — VS Code
.vscode/
*.code-workspace

# IDE — Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
bin/

# IDE — NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# ─── Spring Boot / runtime ────────────────────────────────────────────────────
HELP.md
spring.log
*.log
logs/

# Spring Boot packaged JAR/WAR (keep in .gitignore; push via CI artifact)
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# ─── Database files ───────────────────────────────────────────────────────────
*.db
*.h2.mv.db
*.h2.trace.db
*.sqlite
*.sqlite3

# ─── Docker / containers ──────────────────────────────────────────────────────
# Keep docker-compose.yml tracked; ignore override files
docker-compose.override.yml
docker-compose.local.yml

# ─── Protobuf / gRPC generated code ──────────────────────────────────────────
# Generated by the protobuf-maven-plugin into target/generated-sources
# target/ above already covers this, but explicit for clarity:
**/generated-sources/
**/generated-test-sources/

# ─── Axon Server / event store data ──────────────────────────────────────────
axon-server-se/
axonserver/
data/

# ─── OS / system files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ─── Secrets & local config ───────────────────────────────────────────────────
# Never track secrets or local overrides
*.env
.env
.env.local
application-local.yml
application-local.properties
application-secrets.yml
**/src/main/resources/application-secret*

# ─── Node (if any frontend tooling added later) ───────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Misc ─────────────────────────────────────────────────────────────────────
*.class
*.pid
*.pid.lock
.cache/
